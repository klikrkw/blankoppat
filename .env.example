# ===== Aplikasi =====
APP_NAME=Blanko PPAT
APP_ENV=production
APP_URL=https://blanko.example.com

# ===== MySQL (native Ubuntu Server, bukan container) =====
# PENTING: dari dalam container, 127.0.0.1 menunjuk ke container itu sendiri.
# Gunakan host.docker.internal (sudah disiapkan di docker-compose.yml).
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=blanko_ppat
MYSQL_USER=webuser
MYSQL_PASSWORD=CHANGE_ME

# ===== Frontend / API =====
# KOSONGKAN untuk Docker Compose: frontend memanggil /api/v1/... secara
# same-origin dan nginx yang meneruskan ke backend. JANGAN diisi "/api"
# (path di kode sudah mengandung /api/v1, hasilnya jadi /api/api/... = 404).
# Untuk `npm run dev` tanpa Docker, isi: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ===== Port =====
# Port http Next.js di dalam container (nginx mem-proxy ke sini).
# Ubah di sini + `docker compose up -d` (tanpa rebuild).
FRONTEND_PORT=3002
# Port Nginx yang listen di 127.0.0.1 (target Cloudflare Tunnel di host).
NGINX_PORT=8091

# ===== Keamanan =====
# WAJIB diganti: string acak panjang, mis. hasil `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
# Origin yang diizinkan mengakses API (pisahkan koma), mis.:
# CORS_ORIGINS=https://blanko.example.com
CORS_ORIGINS=*

# ===== Jaringan Docker =====
# Subnet internal compose; izinkan subnet ini ke MySQL port 3306 di firewall.
DOCKER_SUBNET=172.28.0.0/16

# ===== Storage & Lokal =====
# Relatif terhadap WORKDIR container (/app) -> /app/storage.
STORAGE_PATH=storage
TZ=Asia/Jakarta
TIMEZONE=Asia/Jakarta
LOCALE=id-ID

# ===== Integrasi scan e-KTP (opsional) =====
E_KTP_SCAN_WEBHOOK=
E_KTP_SCAN_API_KEY=
E_KTP_SCAN_BASIC_USER=
E_KTP_SCAN_BASIC_PASS=
