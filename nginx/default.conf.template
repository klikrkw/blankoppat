# File ini adalah template: envsubst (bawaan image nginx) mengganti nilai
# FRONTEND_PORT saat container start. Hanya variabel di NGINX_ENVSUBST_FILTER
# yang disubstitusi, jadi variabel nginx seperti $host tetap utuh.
# Sumber nilai: docker-compose.yml (environment: FRONTEND_PORT) atau .env.
upstream frontend_upstream {
    server frontend:${FRONTEND_PORT};
}

upstream backend_upstream {
    server backend:8000;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 20m;

    # Cloudflare Tunnel: gunakan IP asli klien untuk log/rate limit.
    set_real_ip_from 172.16.0.0/12;
    real_ip_header CF-Connecting-IP;

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass http://backend_upstream;
        proxy_set_header Host $host;
    }

    location /storage/ {
        alias /storage/;
        expires 7d;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
